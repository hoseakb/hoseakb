---
import { AUTHOR, SITE, SOCIAL } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__mark">
      <a href="/" class="site-footer__title">{SITE.title}</a>
      <span class="site-footer__sep" aria-hidden="true">—</span>
      <span class="site-footer__tagline">{SITE.tagline}</span>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      <ul class="site-footer__social">
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/tags/">Tags</a></li>
        <li><a href="/about/">About</a></li>
        {
          SOCIAL.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p class="site-footer__legal">
        © {year} <a href={AUTHOR.url}>{AUTHOR.name}</a> · Parbung, Manipur
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    border-top: var(--rule-width) solid var(--color-rule);
    background: var(--color-bg);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-block: 2.5rem 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .site-footer__mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .site-footer__title {
    font-weight: 600;
    color: var(--color-fg-muted);
    text-decoration: none;
    letter-spacing: 0.14em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__title:hover {
    color: var(--color-accent);
  }

  .site-footer__sep {
    color: var(--color-fg-faint);
  }

  .site-footer__tagline {
    color: var(--color-fg-faint);
  }

  /* Dedicated row for all links, centered with generous spacing */
  .site-footer__nav {
    width: 100%;
    padding-block: 1rem;
    border-block: var(--rule-width) solid var(--color-rule);
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__social a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    color: var(--color-accent);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-footer__legal {
    color: var(--color-fg-faint);
  }

  .site-footer__legal a {
    text-decoration: none;
    color: var(--color-fg-muted);
  }

  .site-footer__legal a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 52rem) {
    .site-footer__inner {
      gap: 1.25rem;
      padding-block: 2rem;
    }

    .site-footer__mark {
      flex-direction: column;
      gap: 0.35rem;
    }

    .site-footer__sep {
      display: none;
    }

    .site-footer__social {
      gap: 0.75rem 1.5rem;
    }
  }
</style>
