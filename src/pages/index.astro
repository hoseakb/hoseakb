---
import { render } from "astro:content";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG, SITE } from "../config";
import { formatDate, isoDate } from "../utils/date";
import { getPublishedPosts, type Post } from "../utils/posts";
import "../styles/prose.css";

const allPosts = await getPublishedPosts();

// Curated shortlist of short, evocative poems (~10–14 lines) for dynamic rotation
const CANDIDATE_IDS = [
  "14-tailoring",
  "68-your-ear",
  "58-to-be-your-poet",
  "66-your-witness",
  "28-september-rain",
  "63-your-hands",
];

const featuredCandidates = (
  await Promise.all(
    CANDIDATE_IDS.map(async (id) => {
      const post = allPosts.find((p) => p.id === id);
      if (!post) return null;
      const { Content } = await render(post);
      return { post, Content };
    }),
  )
).filter(
  (item): item is { post: Post; Content: any } => item !== null,
);

const recentPosts = allPosts.slice(0, BLOG.postsOnHome ?? 6);
---

<BaseLayout>
  <!-- Masthead / Archival Colophon -->
  <header class="masthead wrap">
    <div class="masthead__inner">
      <p class="masthead__kicker label">Poetry Archive · Parbung & Churachandpur</p>
      <h1 class="masthead__title">{SITE.title}</h1>
    </div>
  </header>

  <!-- Featured / Opening Poem (Rotates on refresh + shuffle button) -->
  <section class="featured-section wrap">
    <div class="featured-deck" data-featured-deck>
      {
        featuredCandidates.map(({ post, Content }, index) => (
          <article
            class="featured-book"
            data-poem-card
            style={index === 0 ? undefined : "display: none;"}
          >
            <header class="featured-book__header">
              <div class="featured-book__meta">
                <span class="featured-book__badge label">Opening Poem</span>
                <time class="label" datetime={isoDate(post.data.pubDate)}>
                  {formatDate(post.data.pubDate)}
                </time>
                <button
                  type="button"
                  class="featured-book__shuffle label"
                  data-shuffle-btn
                  aria-label="Show another featured poem"
                  title="Click to view another poem"
                >
                  Another poem ↻
                </button>
              </div>
              <h2 class="featured-book__title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
            </header>

            <div class="prose featured-book__body">
              <Content />
            </div>

            <footer class="featured-book__footer">
              <a class="featured-book__link label" href={`/blog/${post.id}/`}>
                Read notes & metadata →
              </a>
            </footer>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Recent Poems Collection -->
  <section class="section wrap latest-section">
    <div class="latest__head">
      <div>
        <h2 class="eyebrow">Recent Poems</h2>
        <p class="label latest__sub">From the archive of {allPosts.length} pieces</p>
      </div>
      <a class="latest__all label" href="/archive/">The List (All {allPosts.length}) →</a>
    </div>

    <div class="latest__list">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>

    <div class="latest__foot">
      <a class="latest__more-btn" href="/archive/">
        View all {allPosts.length} poems in The List →
      </a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const deck = document.querySelector("[data-featured-deck]");
    if (!deck) return;
    const cards = deck.querySelectorAll("[data-poem-card]");
    if (cards.length <= 1) return;

    // Pick random index on each refresh
    let currentIdx = Math.floor(Math.random() * cards.length);

    const activateCard = (idx) => {
      cards.forEach((card, i) => {
        card.style.display = i === idx ? "" : "none";
      });
      currentIdx = idx;
    };

    activateCard(currentIdx);

    // Shuffle button interaction
    deck.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-shuffle-btn]");
      if (!btn) return;
      const nextIdx = (currentIdx + 1) % cards.length;
      activateCard(nextIdx);
    });
  })();
</script>

<style>
  /* Masthead / Colophon */
  .masthead {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    text-align: left;
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .masthead__inner {
    max-width: 42rem;
    margin-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .masthead__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .masthead__title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* Featured Poem / Open Book */
  .featured-section {
    padding-block: var(--space-10) var(--space-14);
  }

  .featured-book {
    max-width: 36rem;
    margin-inline: 0;
    padding: var(--space-8);
    background: var(--color-bg);
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
    box-shadow: none;
  }

  .featured-book__header {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
    text-align: left;
  }

  .featured-book__meta {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .featured-book__badge {
    padding: 0.15em 0.5em;
    background: var(--color-bg-subtle);
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
    color: var(--color-accent);
    text-transform: uppercase;
    font-size: var(--text-xs);
  }

  .featured-book__shuffle {
    margin-left: auto;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-book__shuffle:hover {
    color: var(--color-accent);
  }

  .featured-book__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .featured-book__title a {
    text-decoration: none;
    color: inherit;
  }

  .featured-book__title a:hover {
    color: var(--color-accent);
  }

  .featured-book__body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    text-align: left;
  }

  .featured-book__footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--rule-width) solid var(--color-rule);
    text-align: left;
  }

  .featured-book__link {
    text-decoration: none;
    color: var(--color-fg-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-book__link:hover {
    color: var(--color-accent);
  }

  /* Latest Section */
  .latest-section {
    padding-bottom: var(--space-20);
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__sub {
    margin-top: var(--space-1);
    color: var(--color-fg-faint);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .latest__foot {
    margin-top: var(--space-12);
    text-align: center;
  }

  .latest__more-btn {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    border: var(--rule-width) solid var(--color-rule-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg);
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .latest__more-btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-fg);
  }

  @media (max-width: 45rem) {
    .featured-book {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
