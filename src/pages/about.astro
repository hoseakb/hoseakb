---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, SOCIAL } from "../config";

const colophon = [
  { term: "Author", value: "Hosea Khawbung" },
  { term: "Origin", value: "Parbung, Manipur" },
  { term: "Languages", value: "Hmar · English" },
  { term: "Archive", value: "Poetry · Essays · Commentary" },
];
---

<BaseLayout title="About" description={AUTHOR.bio}>
  <div class="wrap">
    <PageHeader eyebrow="Author" title="About" lede={AUTHOR.bio} />

    <div class="about">
      <div class="prose about__body">
        <p>
          Hosea Khawbung is a bi-lingual poet from Parbung, a sleepy hill village in the Southern district of Manipur.
        </p>

        <p>
          He writes primarily in Hmar, his mother tongue, and English, his language of interaction with the rest of the world.
        </p>

        <p>
          This website is an archive of his poetry and other writings.
        </p>

        <h2>Elsewhere</h2>

        <ul>
          {
            SOCIAL.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about__aside">
        <dl class="about__colophon">
          {
            colophon.map((row) => (
              <div class="about__row">
                <dt class="label">{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-block: var(--space-12);
  }

  .about__aside {
    display: flex;
    gap: var(--space-6);
  }

  .about__rail {
    height: 12rem;
  }

  .about__colophon {
    flex: 1;
    margin: 0;
  }

  .about__row + .about__row {
    margin-top: var(--space-6);
  }

  .about__row dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside {
      padding-top: var(--space-8);
      border-top: var(--rule-width) solid var(--color-rule);
    }

    .about__rail {
      display: none;
    }
  }
</style>
